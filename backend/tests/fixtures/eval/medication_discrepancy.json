  "scenarios": [
    {
      "scenario_id": "med-001",
      "workload": "medication_discrepancy",
      "locale": "en-US",
      "risk": "high",
      "tags": ["duplicate_therapy", "ace_inhibitor", "missing_medication"],
      "inputs": {
        "sources": {
          "local": [{"name": "Lisinopril", "dose": "10 mg", "frequency": "once daily", "status": "active"}],
          "fhir": [
            {"name": "Enalapril", "dose": "10 mg", "frequency": "twice daily", "status": "active"},
            {"name": "Lisinopril", "dose": "10 mg", "frequency": "once daily", "status": "active"}
          ]
        },
        "allergies": []
      },
      "expected": {
        "discrepancies": [
          {"type": "duplicate_therapy", "medications": ["Lisinopril", "Enalapril"]},
          {"type": "missing_medication", "medications": ["Enalapril"]}
        ],
        "abstain": false
      },
      "rationale": "Two ACE inhibitors active at once, one of them absent locally."
    },
