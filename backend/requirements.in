# -- AI / LLM --
google-genai
# The legacy AI Studio SDK pins protobuf<6, which cannot coexist with a patched
# google-cloud-aiplatform on Python 3.14. Docker and CI run 3.12, so the 3.14 lock
# branch omits it and keeps protobuf 6; otherwise the universal lock falls back to
# vulnerable 3.14-only pins. Security floor for GHSA-wh2j-26j7-9728 (bucket naming).
google-generativeai ; python_version < "3.14"
google-cloud-aiplatform>=1.133.0
# OPS-006: enqueue Nora turns for the worker service (Cloud Tasks HTTP targets).
google-cloud-tasks
protobuf>=6.33.5 ; python_version >= "3.14"
multidict>=6.9.1
# Security floor for CVE-2026-111063, CVE-2026-111064 and
# GHSA-2g87-pp6c-29x5. Pulled transitively by Supabase/AI clients.
aiohttp>=3.14.4

# -- Agent runtime --
# `litellm` is floored well above the 1.82.7/1.82.8 releases carrying the unauthorized-code
# advisory; `pip-audit` is a blocking CI gate, so a regression below that floor fails the
# build rather than shipping.
google-adk
litellm>=1.84

