[
  {
    "name": "keep-most-recent-backend-image",
    "action": {
      "type": "Keep"
    },
    "mostRecentVersions": {
      "packageNamePrefixes": [
        "mediagent-backend"
      ],
      "keepCount": 1
    }
  },
  {
    "name": "delete-old-untagged-backend-images",
    "action": {
      "type": "Delete"
    },
    "condition": {
      "tagState": "untagged",
      "olderThan": "1d",
      "packageNamePrefixes": [
        "mediagent-backend"
      ]
    }
  }
]
