# ============================================================
# MediAgent Backend — Environment Variables
#
# HOW TO USE:
#   1. Copy to .env:  cp .env.example .env
#   2. Fill in values from the team's 1Password vault (or ask the team lead)
#   3. NEVER commit .env — it's in .gitignore
#
# KEEPING IN SYNC:
#   - This file is the backend/root env template.
#   - Frontend-only vars live in:
#       apps/patient-portal/.env.example
#       apps/clinician-portal/.env.example
#   - The backend's config.py validates all required vars on startup.
#   - The check-env.sh script (below) catches missing vars before you
#     waste time debugging.
#
# QUICK CHECK:
#   ./scripts/check-env.sh
# ============================================================

# --------------- Supabase ---------------
# Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=               # "anon" "public" key
SUPABASE_SERVICE_ROLE_KEY=       # secret — never expose to frontend
SUPABASE_JWT_SECRET=             # Dashboard → Settings → API → JWT Secret

# Optional independent server-only root, at least 32 random characters.
# Uncomment only when set consistently on every API replica; never NEXT_PUBLIC.
# NOTIFICATION_TOKEN_SIGNING_SECRET=
# Absent: a purpose-derived key, never the raw auth key, preserves rollout.
# Key changes invalidate existing 15-minute snapshots; refresh the notification view.

# --------------- Google / Vertex AI ---------------
GOOGLE_PROJECT_ID=

# --------------- Model Routing ---------------
# Measured under the rebuilt evaluation protocol. Short-term availability: Google may
# retire it 45 days after a replacement ships, so check the release notes before a demo.
GEMINI_TRIAGE_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_MIN_SIMILARITY=0.72

# --------------- Vertex AI ---------------
# Retained for managed open-weight models used by the evaluation harness.
VERTEX_AI_LOCATION=global
# Interactive Gemini models use the global endpoint.
GEMINI_VERTEX_AI_LOCATION=global
CHAT_TURN_TIMEOUT_SECONDS=30
MODEL_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
# Per process and endpoint/model, shared by native chat and background generation.
# Cloud Run replicas/jobs do not share this limit; tune their instance caps separately.
MODEL_MAX_CONCURRENCY=2
MODEL_MIN_START_INTERVAL_SECONDS=0.25

# --------------- Per-workload AI kill switches ---------------
# Setting one to false routes that workload to its deterministic path instead of a
# model. Each path is recorded in backend/src/app/adk/registry.py.
TRIAGE_AI_ENABLED=true
REPLY_AI_ENABLED=true
EXTRACTION_AI_ENABLED=true
DISCREPANCY_AI_ENABLED=true
ADR_EXTRACTION_AI_ENABLED=true
EXPLANATION_AI_ENABLED=true
CARE_PLAN_AI_ENABLED=true
CARE_PLAN_TRANSLATION_AI_ENABLED=true
SOAP_AI_ENABLED=true
# Operational per-attempt ceiling; not a measured performance claim.
SOAP_GENERATION_TIMEOUT_SECONDS=90

# --------------- NVIDIA NIM (provider comparison only) ---------------
# https://build.nvidia.com — used by scripts/compare_providers.py to evaluate a
# provider that is not Google-hosted. No serving path routes to it.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-20b

# --------------- Deepgram ---------------
# https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL_ES=aura-2-estrella-es

# --------------- Resend (email) ---------------
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="MediAgent Notifications <notifications@mail.mediagent.live>"
RESEND_CLINICIAN_ONBOARDING_FROM_EMAIL="MediAgent Clinician Onboarding <onboarding@mail.mediagent.live>"
# Optional dedicated key for hashing email verification codes (falls back to SUPABASE_JWT_SECRET)
EMAIL_CODE_HMAC_SECRET=

# --------------- Sentry ---------------
# https://sentry.io
SENTRY_ENVIRONMENT=development      # development | staging | production
SENTRY_RELEASE=                     # optional, e.g. git SHA or app version
SENTRY_DEBUG=false                  # true only when debugging Sentry locally

# Backend (FastAPI)
BACKEND_SENTRY_DSN=

# --------------- App URLs ---------------
BACKEND_URL=http://localhost:8000
PATIENT_PORTAL_URL=http://localhost:3000
CLINICIAN_PORTAL_URL=http://localhost:3001

# --------------- SMART on FHIR (server-side only) ---------------
# Register SMART_REDIRECT_URI exactly with the sandbox or staging EHR.
SMART_CLIENT_ID=
SMART_CLIENT_SECRET=
SMART_REDIRECT_URI=http://localhost:8000/api/v1/smart/callback
# Generate a Fernet-compatible key in the secret store; never reuse a production key locally.
SMART_STATE_ENCRYPTION_KEY=
# Comma-separated HTTPS FHIR base URLs permitted in this environment.
SMART_ALLOWED_ISSUERS=https://launch.smarthealthit.org/v/r4/fhir
# The SMART Health IT direct-launch simulator uses this distinct FHIR base. Its sim
# segment is the launcher's base64url options array for a patient-standalone launch
# ([3,"","","AUTO",0,0,0,"","","","","","","",0,1,""]). Keep it server-side: the
# portal omits the issuer for standalone launch and the backend uses this value.
# EHR launch issuers remain controlled by SMART_ALLOWED_ISSUERS.
SMART_STANDALONE_ISSUER=https://launch.smarthealthit.org/v/r4/sim/WzMsIiIsIiIsIkFVVE8iLDAsMCwwLCIiLCIiLCIiLCIiLCIiLCIiLCIiLDAsMSwiIl0/fhir
# Launch-context scopes are selected by the backend: launch for EHR launch;
# launch/patient and launch/encounter for standalone sandbox launch.
SMART_SCOPES="patient/Patient.read patient/Encounter.read patient/Condition.read patient/AllergyIntolerance.read patient/MedicationRequest.read patient/MedicationStatement.read patient/Observation.read patient/DiagnosticReport.read patient/Procedure.read patient/CarePlan.read patient/DocumentReference.read"
SMART_LAUNCH_TTL_SECONDS=600
SMART_HANDOFF_TTL_SECONDS=300

# --------------- Internal Cron ---------------
# Shared token for Cloud Scheduler -> backend cron endpoints
CRON_AUTH_TOKEN=

# --------------- Nora turn worker (OPS-006 phase 2) ---------------
# Both flags default to false: leaving them unset keeps Nora turns running inside the API
# process, exactly as before. See docs/chat-worker-setup.md before turning anything on.
# API service: queue each Nora turn in Cloud Tasks; the API never runs model work.
CHAT_TURNS_VIA_WORKER=false
# Worker service only (set by the deploy workflow): serve just the task endpoint.
WORKER_MODE=false
# Queue (API service). The project defaults to GOOGLE_PROJECT_ID.
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=nora-turns
# The worker service's https URL, no trailing slash (printed by the worker deploy step).
CHAT_WORKER_URL=
# Service account the queue signs its OIDC token as; the worker accepts only this caller.
CHAT_WORKER_INVOKER_SA=
# OIDC audience; defaults to CHAT_WORKER_URL.
CHAT_WORKER_OIDC_AUDIENCE=
# Optional tuning: seconds a queued turn may wait for a worker, and tasks one worker runs at once.
# CHAT_TURN_QUEUE_SECONDS=120
# CHAT_WORKER_MAX_CONCURRENCY=4

# --------------- Runtime ---------------
SYMPTOM_INTAKE_ENABLED=false     # Requires a genuinely approved paired-locale bundle and migration 060
# LOC-003: answer translation calls from a deterministic local glossary instead of Vertex AI, so
# the English-first review, guard and attestation paths can be exercised where the model is
# unreachable. Ignored when ENVIRONMENT=production. Stubbed wording is marked in telemetry
# (model offline-translation-stub) and must never be approved as patient-facing wording.
TRANSLATION_STUB_ENABLED=false
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR

# --------------- NVIDIA NIM (evaluation only) ---------------
# https://build.nvidia.com — trial endpoints log requests and carry no BAA.
# Used solely by backend/scripts/benchmark_document_intelligence.py against the
# synthetic corpus. Never send patient data through this key.
NVIDIA_API_KEY=
