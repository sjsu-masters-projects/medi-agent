# ============================================================
# MediAgent Backend — Environment Variables
#
# HOW TO USE:
#   1. Copy to .env:  cp .env.example .env
#   2. Fill in values from the team's 1Password vault (or ask the team lead)
#   3. NEVER commit .env — it's in .gitignore
#
# KEEPING IN SYNC:
#   - This file is the backend/root env template.
#   - Frontend-only vars live in:
#       apps/patient-portal/.env.example
#       apps/clinician-portal/.env.example
#   - The backend's config.py validates all required vars on startup.
#   - The check-env.sh script (below) catches missing vars before you
#     waste time debugging.
#
# QUICK CHECK:
#   ./scripts/check-env.sh
# ============================================================

# --------------- Supabase ---------------
# Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=               # "anon" "public" key
SUPABASE_SERVICE_ROLE_KEY=       # secret — never expose to frontend
SUPABASE_JWT_SECRET=             # Dashboard → Settings → API → JWT Secret

# --------------- Google / Vertex AI ---------------
GOOGLE_PROJECT_ID=

# --------------- Model Routing ---------------
# Measured under the rebuilt evaluation protocol. Short-term availability: Google may
# retire it 45 days after a replacement ships, so check the release notes before a demo.
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_MIN_SIMILARITY=0.72

# --------------- Vertex AI ---------------
VERTEX_AI_LOCATION=us-central1

# --------------- Per-workload AI kill switches ---------------
# Setting one to false routes that workload to its deterministic path instead of a
# model. Each path is recorded in backend/src/app/adk/registry.py.
TRIAGE_AI_ENABLED=true
REPLY_AI_ENABLED=true
EXTRACTION_AI_ENABLED=true
DISCREPANCY_AI_ENABLED=true
ADR_EXTRACTION_AI_ENABLED=true
EXPLANATION_AI_ENABLED=true

# --------------- NVIDIA NIM (provider comparison only) ---------------
# https://build.nvidia.com — used by scripts/compare_providers.py to evaluate a
# provider that is not Google-hosted. No serving path routes to it.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-20b

# --------------- Deepgram ---------------
# https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL_ES=aura-2-javier-es

# --------------- Resend (email) ---------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Optional: used as From fallback when RESEND_CLINICIAN_ONBOARDING_FROM_EMAIL is empty (defaults in config.py otherwise)
# RESEND_FROM_EMAIL=
RESEND_CLINICIAN_ONBOARDING_FROM_EMAIL="MediAgent Clinician Onboarding <onboarding@mail.mediagent.live>"

# --------------- Sentry ---------------
# https://sentry.io
SENTRY_ENVIRONMENT=development      # development | staging | production
SENTRY_RELEASE=                     # optional, e.g. git SHA or app version
SENTRY_DEBUG=false                  # true only when debugging Sentry locally

# Backend (FastAPI)
BACKEND_SENTRY_DSN=

# --------------- App URLs ---------------
BACKEND_URL=http://localhost:8000
PATIENT_PORTAL_URL=http://localhost:3000
CLINICIAN_PORTAL_URL=http://localhost:3001

# --------------- SMART on FHIR (server-side only) ---------------
# Register SMART_REDIRECT_URI exactly with the sandbox or staging EHR.
SMART_CLIENT_ID=
SMART_CLIENT_SECRET=
SMART_REDIRECT_URI=http://localhost:8000/api/v1/smart/callback
# Generate a Fernet-compatible key in the secret store; never reuse a production key locally.
SMART_STATE_ENCRYPTION_KEY=
# Comma-separated HTTPS FHIR base URLs permitted in this environment.
SMART_ALLOWED_ISSUERS=https://launch.smarthealthit.org/v/r4/fhir
# The SMART Health IT direct-launch simulator uses this distinct FHIR base.
# Keep it server-side; EHR launch issuers remain controlled by SMART_ALLOWED_ISSUERS.
SMART_STANDALONE_ISSUER=https://launch.smarthealthit.org/v/r4/sim/eyJsYXVuY2hfdHlwZSI6InBhdGllbnQtc3RhbmRhbG9uZSJ9/fhir
# Launch-context scopes are selected by the backend: launch for EHR launch;
# launch/patient and launch/encounter for standalone sandbox launch.
SMART_SCOPES="patient/Patient.read patient/Encounter.read patient/Condition.read patient/AllergyIntolerance.read patient/MedicationRequest.read patient/MedicationStatement.read patient/Observation.read patient/DiagnosticReport.read patient/Procedure.read patient/CarePlan.read patient/DocumentReference.read"
SMART_LAUNCH_TTL_SECONDS=600
SMART_HANDOFF_TTL_SECONDS=300

# --------------- Internal Cron ---------------
# Shared token for Cloud Scheduler -> backend cron endpoints
CRON_AUTH_TOKEN=

# --------------- Runtime ---------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR

# --------------- NVIDIA NIM (evaluation only) ---------------
# https://build.nvidia.com — trial endpoints log requests and carry no BAA.
# Used solely by backend/scripts/benchmark_document_intelligence.py against the
# synthetic corpus. Never send patient data through this key.
NVIDIA_API_KEY=
