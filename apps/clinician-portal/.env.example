# ============================================================
# MediAgent Clinician Portal — Local Environment Template
#
# Use this when running the clinician portal with app-local env
# files. Keep only clinician-portal vars here.
# ============================================================

# --------------- Public App Config ---------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep disabled until the deployed Realtime publication and clinician JWT path have been verified.
NEXT_PUBLIC_ENABLE_DASHBOARD_REALTIME=false

# --------------- Sentry ---------------
# Clinician portal project only:
#   - mediagent-clinician-portal
SENTRY_ENVIRONMENT=development      # development | staging | production
SENTRY_RELEASE=                     # optional, e.g. git SHA or app version
SENTRY_DEBUG=false
CLINICIAN_PORTAL_SENTRY_DSN=
NEXT_PUBLIC_CLINICIAN_PORTAL_SENTRY_DSN=
CLINICIAN_PORTAL_SENTRY_PROJECT=mediagent-clinician-portal

# Optional: source map uploads / release automation
SENTRY_ORG=
SENTRY_AUTH_TOKEN=

# --------------- Session limits (optional; the defaults need no change) ---------------
# NEXT_PUBLIC_CLINICIAN_SESSION_IDLE_MINUTES=120    # sign out after this many idle minutes
# NEXT_PUBLIC_CLINICIAN_SESSION_MAX_HOURS=12        # absolute maximum from sign-in
# NEXT_PUBLIC_CLINICIAN_SESSION_WARNING_SECONDS=120 # warning shown before the idle limit
