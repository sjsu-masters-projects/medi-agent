# ============================================================
# MediAgent Patient Portal — Local Environment Template
#
# Use this when running the patient portal with app-local env
# files. Keep only patient-portal vars here.
# ============================================================

# --------------- Public App Config ---------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SYNCFUSION_LICENSE_KEY=

# --------------- Sentry ---------------
# Patient portal project only:
#   - mediagent-patient-portal
SENTRY_ENVIRONMENT=development      # development | staging | production
SENTRY_RELEASE=                     # optional, e.g. git SHA or app version
SENTRY_DEBUG=false
PATIENT_PORTAL_SENTRY_DSN=
NEXT_PUBLIC_PATIENT_PORTAL_SENTRY_DSN=
PATIENT_PORTAL_SENTRY_PROJECT=mediagent-patient-portal

# Optional: source map uploads / release automation
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
